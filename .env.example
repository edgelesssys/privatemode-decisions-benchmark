# copy to .env -- never commit the real keys

# Privatemode: the OpenAI-compatible endpoint of a running privatemode-proxy.
#   docker run -d -p 8082:8080 ghcr.io/edgelesssys/privatemode/privatemode-proxy:latest \
#     --apiKey <your-privatemode-api-key>
# The proxy holds the key, so SYSTEM_ONE_API_KEY may stay empty when it does.
SYSTEM_ONE_BASE_URL=http://127.0.0.1:8082/v1
SYSTEM_ONE_API_KEY=
SYSTEM_ONE_MODEL=glm-5.3-flash
# Writes the label synonyms for the contamination control. Deliberately a
# model none of the arms is built on.
PERTURB_MODEL=gpt-oss-120b

# TypeSafe AI (Jev)
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=your-typesafe-api-key
JEV_MODEL=jev-latest

# Optional: a Hugging Face read token raises the datasets-server rate limit
HF_TOKEN=
